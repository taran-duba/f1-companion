# Copy to .env and fill in what you need: cp .env.example .env
# Every setting is optional. With none set, the app runs the bundled demo race.
# .env is gitignored. Never commit it. See docs/SETUP.md.

# --- Backend (read from the repo root .env by `python -m f1live serve`) ---

# Where the dashboard starts: demo (default), live, or a path to a .jsonl[.gz] recording.
# F1_SOURCE=demo

# F1 TV subscription token. Unlocks live car telemetry and the track map in live mode.
# You can also paste it in the dashboard (Settings -> source panel) instead.
# F1TV_TOKEN=

# F1 TV login, only for loading past sessions through FastF1 (Replay -> FastF1).
# F1_USERNAME=
# F1_PASSWORD=

# Live transport: core (default, current SignalR Core endpoint) or legacy.
# F1_TRANSPORT=core

# Comma-separated browser origins allowed to call the API. Default is * (any origin).
# Set this if the API is reachable by anyone other than you.
# F1_CORS_ORIGINS=http://localhost:3000

# Storage locations (defaults are under data/).
# F1_RECORDINGS_DIR=
# F1_CREDENTIALS_FILE=
# F1LIVE_FASTF1_CACHE=
# F1_DEMO_FILE=

# --- Frontend (Next.js reads these from frontend/.env.local, not this file) ---

# API origin when the backend is not on <same host>:8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000
